diff_interbank <- compare_bis("interbank", "totdep")
diff_interbank %>%
summarise(
n = n(),
max_diff = max(abs_diff, na.rm = TRUE),
median_diff = median(abs_diff, na.rm = TRUE),
p95 = quantile(abs_diff, 0.95, na.rm = TRUE),
p99 = quantile(abs_diff, 0.99, na.rm = TRUE),
n_above_001 = sum(abs_diff > 0.01, na.rm = TRUE),
n_above_1 = sum(abs_diff > 1, na.rm = TRUE)
)
diff_interbank %>%
filter(abs_diff > 1) %>%
arrange(desc(abs_diff)) %>%
select(
year, bank, saver,
value_r, value_s, abs_diff
) %>%
print(n = Inf)
library(dplyr)
float32 <- function(x) {
readBin(
writeBin(as.numeric(x), raw(), size = 4),
what = "numeric",
n = length(x),
size = 4
)
}
