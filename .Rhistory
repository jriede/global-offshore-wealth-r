filter(bank == "1R", saver == "5J") %>%
mutate(
value_r_float = float32(value_r),
diff_float = abs(value_r_float - value_s)
) %>%
select(
year, value_r, value_s,
abs_diff, value_r_float, diff_float
) %>%
arrange(desc(abs_diff)) %>%
print(n = Inf)
