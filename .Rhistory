duplicate_keys = c(
sum(duplicated(r[keys])),
sum(duplicated(s[keys]))
)
))
comparison <- full_join(
r %>% rename(value_r = all_of(value_col), ofc_r = OFC),
s %>% rename(value_s = all_of(value_col), ofc_s = OFC),
by = keys,
na_matches = "never"
